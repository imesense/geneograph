# Enable top-most EditorConfig file
root = true

# Visual Studio solutions
[*.sln]

# Common settings
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
indent_style = tab
insert_final_newline = true
tab_width = 4

# XML-based files
[*.{csproj,props,targets,xaml,axaml,xml,manifest,resx}]

# Common settings
charset = utf-8
end_of_line = crlf
indent_size = 4
indent_style = space
insert_final_newline = true

# JSON-based files
[*.{json,code-workspace,XamlStyler}]

# Common settings
charset = utf-8
end_of_line = crlf
indent_size = 4
indent_style = space
insert_final_newline = true

# YAML-based files
[*.{yml,yaml}]

# Common settings
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true

# Markdown files
[*.md]

# Common settings
charset = utf-8
end_of_line = crlf
indent_size = 2
indent_style = space
insert_final_newline = true

# C# code style settings
[*.cs]

# Common settings
charset = utf-8
end_of_line = crlf
indent_size = 4
indent_style = space
insert_final_newline = true

# Namespace settings
dotnet_style_namespace_match_folder = false:silent

# Import directives settings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Prefer "var" everywhere
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = false
csharp_style_var_elsewhere = false

# Space preferences
csharp_space_after_cast = true
