<ResourceDictionary
    x:ClassModifier="public"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <Border.Styles>
                <Style Selector="Border StackPanel">
                    <Setter Property="Spacing" Value="5" />
                </Style>

                <Style Selector="Border StackPanel > Border">
                    <Setter Property="BorderBrush" Value="Gray" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="CornerRadius" Value="18" />
                </Style>

                <Style Selector="Border StackPanel > Border Ellipse">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                </Style>
            </Border.Styles>

            <StackPanel Orientation="Vertical">
                <Label Content="Transparent" />

                <!-- Transparent brushes 1 -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="5">
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.100}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.90}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.80}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.70}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.60}" />
                    </Border>
                </StackPanel>

                <!-- Transparent brushes 2 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.50}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.40}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.30}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.20}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.10}" />
                    </Border>
                </StackPanel>

                <!-- Transparent brushes 3 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.75}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Transparent.Brushes.25}" />
                    </Border>
                </StackPanel>

                <Label Content="Background Main" />

                <!-- Background Main brushes -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Background.Brushes.Main}" />
                    </Border>
                </StackPanel>

                <Label Content="Background Panel" />

                <!-- Background Panel brushes -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Background.Brushes.Panel}" />
                    </Border>
                </StackPanel>

                <Label Content="Background Panel Light" />

                <!-- Background PanelLight brushes -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Background.Brushes.PanelLight}" />
                    </Border>
                </StackPanel>

                <Label Content="Accent Main" />

                <!-- Accent Main brushes 1 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.100}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.90}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.80}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.70}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.60}" />
                    </Border>
                </StackPanel>

                <!-- Accent Main brushes 2 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.50}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.40}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.30}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.20}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.10}" />
                    </Border>
                </StackPanel>

                <!-- Accent Main brushes 3 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.75}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Main.25}" />
                    </Border>
                </StackPanel>

                <Label Content="Accent Main Light" />

                <!-- Accent Main Light brushes 1 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.100}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.90}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.80}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.70}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.60}" />
                    </Border>
                </StackPanel>

                <!-- Accent Main Light brushes 2 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.50}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.40}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.30}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.20}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.10}" />
                    </Border>
                </StackPanel>

                <!-- Accent Main Light brushes 3 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.75}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.MainLight.25}" />
                    </Border>
                </StackPanel>

                <Label Content="Accent Main Tertiary" />

                <!-- Accent Tertiary brushes 1 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.100}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.90}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.80}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.70}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.60}" />
                    </Border>
                </StackPanel>

                <!-- Accent Tertiary brushes 2 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.50}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.40}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.30}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.20}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.10}" />
                    </Border>
                </StackPanel>

                <!-- Accent Tertiary brushes 3 -->
                <StackPanel Orientation="Horizontal">
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.75}" />
                    </Border>
                    <Border>
                        <Ellipse Fill="{DynamicResource Accent.Brushes.Tertiary.25}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ResourceDictionary.ThemeDictionaries>
        <!-- Light theme -->
        <ResourceDictionary x:Key="Light">
            <!-- Transparent main brushes -->
            <SolidColorBrush x:Key="Transparent.Brushes.100" Color="{StaticResource Monochrome.Colors.Black}" Opacity="1.0" />
            <SolidColorBrush x:Key="Transparent.Brushes.90" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.9" />
            <SolidColorBrush x:Key="Transparent.Brushes.80" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.8" />
            <SolidColorBrush x:Key="Transparent.Brushes.70" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.7" />
            <SolidColorBrush x:Key="Transparent.Brushes.60" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.6" />
            <SolidColorBrush x:Key="Transparent.Brushes.50" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.5" />
            <SolidColorBrush x:Key="Transparent.Brushes.40" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.4" />
            <SolidColorBrush x:Key="Transparent.Brushes.30" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.3" />
            <SolidColorBrush x:Key="Transparent.Brushes.20" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.2" />
            <SolidColorBrush x:Key="Transparent.Brushes.10" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.1" />

            <!-- Transparent additional brushes -->
            <SolidColorBrush x:Key="Transparent.Brushes.75" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.75" />
            <SolidColorBrush x:Key="Transparent.Brushes.25" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.25" />
            <SolidColorBrush x:Key="Transparent.Brushes.5" Color="{StaticResource Monochrome.Colors.Black}" Opacity="0.05" />
        </ResourceDictionary>

        <!-- Dark theme -->
        <ResourceDictionary x:Key="Dark">
            <!-- Transparent main brushes -->
            <SolidColorBrush x:Key="Transparent.Brushes.100" Color="{StaticResource Monochrome.Colors.White}" Opacity="1.0" />
            <SolidColorBrush x:Key="Transparent.Brushes.90" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.9" />
            <SolidColorBrush x:Key="Transparent.Brushes.80" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.8" />
            <SolidColorBrush x:Key="Transparent.Brushes.70" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.7" />
            <SolidColorBrush x:Key="Transparent.Brushes.60" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.6" />
            <SolidColorBrush x:Key="Transparent.Brushes.50" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.5" />
            <SolidColorBrush x:Key="Transparent.Brushes.40" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.4" />
            <SolidColorBrush x:Key="Transparent.Brushes.30" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.3" />
            <SolidColorBrush x:Key="Transparent.Brushes.20" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.2" />
            <SolidColorBrush x:Key="Transparent.Brushes.10" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.1" />

            <!-- Transparent additional brushes -->
            <SolidColorBrush x:Key="Transparent.Brushes.75" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.75" />
            <SolidColorBrush x:Key="Transparent.Brushes.25" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.25" />
            <SolidColorBrush x:Key="Transparent.Brushes.5" Color="{StaticResource Monochrome.Colors.White}" Opacity="0.05" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Monochrome colors -->
    <Color x:Key="Monochrome.Colors.Black">#000000</Color>
    <Color x:Key="Monochrome.Colors.White">#FFFFFF</Color>

    <!-- Background colors -->
    <Color x:Key="Background.Colors.Main">#121212</Color>
    <Color x:Key="Background.Colors.Panel">#1A1A1A</Color>
    <Color x:Key="Background.Colors.PanelLight">#212121</Color>

    <!-- Background brushes -->
    <SolidColorBrush x:Key="Background.Brushes.Main" Color="{StaticResource Background.Colors.Main}" />
    <SolidColorBrush x:Key="Background.Brushes.Panel" Color="{StaticResource Background.Colors.Panel}" />
    <SolidColorBrush x:Key="Background.Brushes.PanelLight" Color="{StaticResource Background.Colors.PanelLight}" />

    <!-- Lines colors -->
    <Color x:Key="Lines.Colors.Stroke">#414141</Color>

    <!-- Lines brushes -->
    <SolidColorBrush x:Key="Lines.Brushes.Stroke" Color="{StaticResource Lines.Colors.Stroke}" />

    <!-- Accent colors -->
    <Color x:Key="Accent.Colors.Main">#2B9563</Color>
    <Color x:Key="Accent.Colors.MainLight">#9DCEB7</Color>
    <Color x:Key="Accent.Colors.Tertiary">#154830</Color>

    <!-- Accent Main main brushes -->
    <SolidColorBrush x:Key="Accent.Brushes.Main.100" Color="{StaticResource Accent.Colors.Main}" Opacity="1.0" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.90" Color="{StaticResource Accent.Colors.Main}" Opacity="0.9" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.80" Color="{StaticResource Accent.Colors.Main}" Opacity="0.8" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.70" Color="{StaticResource Accent.Colors.Main}" Opacity="0.7" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.60" Color="{StaticResource Accent.Colors.Main}" Opacity="0.6" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.50" Color="{StaticResource Accent.Colors.Main}" Opacity="0.5" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.40" Color="{StaticResource Accent.Colors.Main}" Opacity="0.4" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.30" Color="{StaticResource Accent.Colors.Main}" Opacity="0.3" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.20" Color="{StaticResource Accent.Colors.Main}" Opacity="0.2" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.10" Color="{StaticResource Accent.Colors.Main}" Opacity="0.1" />

    <!-- Accent Main additional brushes -->
    <SolidColorBrush x:Key="Accent.Brushes.Main.75" Color="{StaticResource Accent.Colors.Main}" Opacity="0.75" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.25" Color="{StaticResource Accent.Colors.Main}" Opacity="0.25" />
    <SolidColorBrush x:Key="Accent.Brushes.Main.5" Color="{StaticResource Accent.Colors.Main}" Opacity="0.5" />

    <!-- Accent Main Light main brushes -->
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.100" Color="{StaticResource Accent.Colors.MainLight}" Opacity="1.0" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.90" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.9" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.80" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.8" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.70" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.7" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.60" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.6" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.50" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.5" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.40" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.4" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.30" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.3" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.20" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.2" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.10" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.1" />

    <!-- Accent Main Light additional brushes -->
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.75" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.75" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.25" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.25" />
    <SolidColorBrush x:Key="Accent.Brushes.MainLight.5" Color="{StaticResource Accent.Colors.MainLight}" Opacity="0.05" />

    <!-- Accent Tertiary main brushes -->
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.100" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="1.0" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.90" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.9" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.80" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.8" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.70" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.7" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.60" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.6" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.50" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.5" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.40" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.4" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.30" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.3" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.20" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.2" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.10" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.1" />

    <!-- Accent Tertiary additional brushes -->
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.75" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.75" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.25" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.25" />
    <SolidColorBrush x:Key="Accent.Brushes.Tertiary.5" Color="{StaticResource Accent.Colors.Tertiary}" Opacity="0.05" />
</ResourceDictionary>
