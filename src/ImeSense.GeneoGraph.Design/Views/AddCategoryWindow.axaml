<Window
    x:Class="ImeSense.GeneoGraph.Design.Views.AddCategoryWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="using:ImeSense.GeneoGraph.Design.Views"
    xmlns:vm="using:ImeSense.GeneoGraph.Design.ViewModels"
    Width="400"
    Height="200"
    Background="Transparent"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="-1"
    ExtendClientAreaToDecorationsHint="True"
    FontFamily="Inter"
    FontSize="16"
    Foreground="#dedede"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#9dce8e" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#9dce8e" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
    </Window.Styles>

    <Border
        Background="#2e2e2e"
        CornerRadius="15">
        <Grid
            Margin="15"
            ColumnDefinitions="*,*"
            RowDefinitions="Auto, Auto, Auto">
            <Label
                Grid.ColumnSpan="2"
                FontSize="14">
                Category Name
            </Label>

            <TextBox
                Grid.ColumnSpan="2"
                Grid.Row="1"
                Text="{Binding NewCategoryName}"
                Margin="0,10,0,0"
                Padding="15"
                VerticalContentAlignment="Center"
                CornerRadius="10"
                FontSize="18"
                Watermark="New category" />

            <Button
                Grid.Row="2"
                Command="{Binding AddCategoryClose}"
                Width="120"
                Margin="0,25,30,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="#dedede"
                BorderThickness="2"
                CornerRadius="25"
                Foreground="#dedede">
                <Label
                    Padding="20,5,20,5"
                    HorizontalAlignment="Center"
                    FontSize="16">
                    Cancel
                </Label>
            </Button>

            <Button
                Grid.Column="1"
                Grid.Row="2"
                Command="{Binding AddCategory}"
                Width="120"
                Margin="30,25,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                BorderThickness="2"
                CornerRadius="25">
                <Label
                    Padding="20,5,20,5"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="Black">
                    Save
                </Label>
            </Button>
        </Grid>
    </Border>
</Window>
