<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="ImeSense.GeneoGraph.Design.Views.PDPartners"
             d:DesignWidth="500" 
             d:DesignHeight="785"
             FontFamily="Inter"
             FontSize="16"
             FontWeight="Medium">
    <Grid Background="Transparent"
          Margin="20"
          ShowGridLines="False"
          RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
          ColumnDefinitions="*,Auto">

        <!--Add new partner-->
        <StackPanel Orientation="Horizontal">
            <Button
                    Width="35"
                    Height="35"
                    Background="Transparent"
                    CornerRadius="32"
                    Margin="0,0,10,0">
                <Image
                    Source="..\..\Assets\Buttons\plus.png"
                    Stretch="Uniform" />
            </Button>

            <Button
                    Width="35"
                    Height="35"
                    Background="Transparent"
                    CornerRadius="32">
                <Image
                    Source="..\..\Assets\Buttons\unlink.png"
                    Stretch="Uniform" />
            </Button>
        </StackPanel>

        <Button
        Width="35"
        Height="35"
        Background="Transparent"
        HorizontalAlignment="Right"
        CornerRadius="32"
        Margin="0,0,0,0">
            <Image
                Source="..\..\Assets\Buttons\next.png"
                Stretch="Uniform" />
        </Button>


        <!--Partner info: Photo, name, dates, status-->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              VerticalAlignment="Top"
              Margin="0,20,0,0">
            <Border
                    Width="100"
                    Height="100"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    CornerRadius="100"
                    Margin="0,0,25,0">
                <Image
                    Width="100"
                    Height="100"
                    Source="..\Assets\Profile\Profile_picture.png"
                    Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1">
                <Label 
                    FontSize="18"
                    Margin="0,0,0,5">
                    Nikita Lebedin
                </Label>
                <Label 
                    FontSize="16"
                    Margin="0,0,0,15">
                    2022 - Present
                </Label>
                <ComboBox
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Background="#121212"
                    BorderBrush="#316A42"
                    BorderThickness="0,0,0,2"
                    CornerRadius="5" />
            </StackPanel>
        </Grid>

        <!--Relashionship start group-->
        <Grid
                    Grid.Row="2"
                    Margin="0,35,0,0"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ShowGridLines="False">
            <StackPanel Margin="0,0,15,0">
                <Label
                    Content="Relationship Start Date"
                    Margin="0,0,0,5" />
                <ComboBox
                    Grid.Row="1"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Background="#121212"
                    BorderBrush="#316A42"
                    BorderThickness="0,0,0,2"
                    CornerRadius="5" />
            </StackPanel>

            <TextBox
                Grid.Column="1"
                Text=""
                Height="40"
                VerticalAlignment="Bottom"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />

            <TextBox
                Grid.Column="1"
                Grid.Row="1"
                Text=""
                Height="40"
                Margin="0,20,0,0"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </Grid>

        <!--Relationship start place-->
        <StackPanel
            Grid.Row="3"
            Margin="0,35,0,0">
            <Label
                Content="Relationship Start Place"
                Margin="0,0,0,5" />
            <TextBox
                Text=""
                Height="40"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </StackPanel>

        <!--Witnesses-->
        <StackPanel
            Grid.Row="4"
            Margin="0,35,0,0">
            <Label
                Content="Witnesses"
                Margin="0,0,0,5" />
            <TextBox
                Text=""
                Height="40"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </StackPanel>

        <!--Relashionship end group-->
        <Grid
                    Grid.Row="5"
                    Margin="0,35,0,0"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ShowGridLines="False">
            <StackPanel Margin="0,0,15,0">
                <Label
                    Content="Relationship End Date"
                    Margin="0,0,0,5" />
                <ComboBox
                    Grid.Row="1"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Background="#121212"
                    BorderBrush="#316A42"
                    BorderThickness="0,0,0,2"
                    CornerRadius="5" />
            </StackPanel>

            <TextBox
                Grid.Column="1"
                Text=""
                Height="40"
                VerticalAlignment="Bottom"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />

            <TextBox
                Grid.Column="1"
                Grid.Row="1"
                Text=""
                Height="40"
                Margin="0,20,0,0"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </Grid>
        
    </Grid>
</UserControl>
