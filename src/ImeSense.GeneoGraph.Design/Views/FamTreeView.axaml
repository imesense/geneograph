        </StreamGeometry>
    </UserControl.Resources>

    <Grid
        ColumnDefinitions="Auto, *, Auto"
        ShowGridLines="False">
        <!-- Left toolbar -->
        <Border Background="Transparent">
            <StackPanel
                Margin="10"
                VerticalAlignment="Bottom"
                Orientation="Vertical">
                <Button
                    Command="{Binding AddPersonOpenCommand}"
                    Width="48"
                    Height="48"
                    Margin="0,0,0,25"
                    Background="#474747"
                    BorderBrush="#636363">
                    <PathIcon
                        Data="{DynamicResource AddPerson}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                </Button>

                <Button
                    Width="48"
                    Height="48"
                    Margin="0"
                    Background="#474747"
                    BorderBrush="#636363">
                    <PathIcon
                        Data="{DynamicResource FamilyTree}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                </Button>

                <Button
                    Width="48"
                    Height="48"
                    Margin="0,10,0,0"
                    Background="#474747"
                    BorderBrush="#636363">
                    <PathIcon
                        Data="{DynamicResource FamilyTree}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        RenderTransform="rotate(90deg)"
                        Foreground="#dedede" />
                </Button>

                <Button
                    Width="48"
                    Height="48"
                    Margin="0,10,0,0"
                    Background="#474747"
                    BorderBrush="#636363">
                    <PathIcon
                        Data="{DynamicResource Table}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                </Button>

                <Button
                    Width="48"
                    Height="48"
                    Margin="0,25,0,0"
                    Background="#474747"
                    BorderBrush="#636363">
                    <PathIcon
                        Data="{DynamicResource Plus}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                </Button>

                <Button
                    Width="48"
                    Height="48"
                    Margin="0,10,0,0"
                    Background="#474747"
                    BorderBrush="#636363">
                    <PathIcon
                        Data="{DynamicResource Minus}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                </Button>

                <Button
                    Width="48"
                    Height="48"
                    Margin="0,25,0,0"
                    Background="#474747"
                    BorderBrush="#636363">
                    <PathIcon
                        Data="{DynamicResource Settings}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Family tree -->
        <DataGrid
            x:Name="PeopleListGrid"
            Grid.Column="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding PeopleList, Mode=TwoWay}"
            SelectedIndex="{Binding SelectedPersonIndex}"
            SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Id}"
                    Header="ID" />
                <DataGridTextColumn
                    Binding="{Binding FirstName}"
                    Header="First Name" />
                <DataGridTextColumn
                    Binding="{Binding LastName}"
                    Header="Last Name" />
                <DataGridTextColumn
                    Binding="{Binding Gender}"
                    Header="Gender" />
                <DataGridTextColumn
                    Binding="{Binding IsDeceased}"
                    Header="Deceased" />
                <DataGridTextColumn
                    Binding="{Binding BirthDate, StringFormat=dd-MMM-yyyy}"
                    Header="Birth Date" />
                <DataGridTextColumn
                    Binding="{Binding BirthPlace}"
                    Header="Birth Place" />
                <DataGridTextColumn
                    Binding="{Binding DeathDate, StringFormat=dd-MMM-yyyy}"
                    Header="Death Date" />
                <DataGridTextColumn
                    Binding="{Binding DeathPlace}"
                    Header="Death Place" />
                <DataGridTextColumn
                    Binding="{Binding Age}"
                    Header="Age" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Right toolbar -->
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal">
            <Button
                Command="{Binding SideBarOpenCloseCommand}"
                Width="60"
                Height="40"
                Margin="0,30,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#1e1e1e"
                BorderBrush="#777777"
                BorderThickness="1,1,0,1"
                CornerRadius="20,0,0,20"
                IsVisible="{Binding SidebarButtonVisibility}">
                <Border
                    Width="26"
                    Height="26"
                    BorderBrush="#dedede"
                    BorderThickness="2"
                    CornerRadius="32">
                    <PathIcon
                        Data="{DynamicResource Arrow}"
                        Width="14"
                        Height="14"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                </Border>
            </Button>

            <DockPanel
                Grid.Column="2"
                IsVisible="{Binding SidebarStatus, Mode=TwoWay}">
                <Border Grid.Column="2">
                    <v:PropertiesView />
                </Border>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
