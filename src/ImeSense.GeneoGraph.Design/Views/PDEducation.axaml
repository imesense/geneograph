<UserControl
    x:Class="ImeSense.GeneoGraph.Design.Views.PDEducation"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    MinHeight="588"
    d:DesignHeight="588"
    d:DesignWidth="850"
    Background="Transparent"
    FontFamily="Inter"
    FontSize="16"
    FontWeight="Medium"
    mc:Ignorable="d">
    <Grid
        Margin="25"
        Background="Transparent"
        ColumnDefinitions="*,*,Auto"
        RowDefinitions="Auto,Auto,Auto">
        <!-- Education place -->
        <StackPanel
            Grid.ColumnSpan="2"
            Margin="0,0,10,0">
            <Label
                Content="Education Place"
                Margin="0,0,0,5" />
            <TextBox
                Text=""
                Height="40"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </StackPanel>

        <!-- Add new Education place button -->
        <Button
            Grid.Column="2"
            Width="35"
            Height="35"
            Margin="20,0,5,0"
            CornerRadius="32">
            <Image
                Source="..\..\Assets\Buttons\plus.png"
                Stretch="Uniform" />
        </Button>

        <!-- Education notes -->
        <StackPanel
            Grid.ColumnSpan="2"
            Grid.Row="1"
            Margin="0,20,10,0">
            <Label
                Content="Notes"
                Margin="0,0,0,5" />
            <TextBox
                Text=""
                Height="40"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </StackPanel>

        <!-- Education From date group -->
        <Grid
            Grid.Row="2"
            Margin="0,35,25,0"
            ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto"
            ShowGridLines="False">
            <StackPanel Margin="0,0,15,0">
                <Label
                    Content="From"
                    Margin="0,0,0,5" />
                <ComboBox
                    Grid.Row="1"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Background="#121212"
                    BorderBrush="#316A42"
                    BorderThickness="0,0,0,2"
                    CornerRadius="5" />
            </StackPanel>

            <TextBox
                Grid.Column="1"
                Text=""
                Height="40"
                Margin="0,0,10,0"
                VerticalAlignment="Bottom"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />

            <TextBox
                Grid.Column="1"
                Grid.Row="1"
                Text=""
                Height="40"
                Margin="0,20,10,0"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </Grid>

        <!-- Education To date group -->
        <Grid
            Grid.Column="1"
            Grid.Row="2"
            Margin="30,35,0,0"
            ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto"
            ShowGridLines="False">
            <StackPanel Margin="0,0,15,0">
                <Label
                    Content="To"
                    Margin="0,0,0,5" />
                <ComboBox
                    Grid.Row="1"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Background="#121212"
                    BorderBrush="#316A42"
                    BorderThickness="0,0,0,2"
                    CornerRadius="5" />
            </StackPanel>
            <TextBox
                Grid.Column="1"
                Text=""
                Height="40"
                Margin="0,0,10,0"
                VerticalAlignment="Bottom"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />

            <TextBox
                Grid.Column="1"
                Grid.Row="1"
                Text=""
                Height="40"
                Margin="0,20,10,0"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </Grid>
    </Grid>
</UserControl>
