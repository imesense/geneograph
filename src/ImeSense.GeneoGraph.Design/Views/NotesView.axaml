        <StreamGeometry x:Key="Sort">
            M7.00002 5C7.00002 4.44772 6.5523 4 6.00002 4C5.44773 4 5.00002 4.44772 5.00002 5V16.5858L3.7071 15.2929C3.31658 14.9024 2.68341 14.9024 2.29289 15.2929C1.90237 15.6834 1.90237 16.3166 2.2929 16.7071L5.29291 19.7071C5.48045 19.8946 5.73481 20 6.00002 20C6.26524 20 6.51959 19.8946 6.70713 19.7071L9.70711 16.7071C10.0976 16.3166 10.0976 15.6834 9.7071 15.2929C9.31658 14.9024 8.68341 14.9024 8.29289 15.2929L7.00002 16.5858V5ZM13 6C12.4477 6 12 6.44772 12 7C12 7.55228 12.4477 8 13 8H21C21.5523 8 22 7.55228 22 7C22 6.44772 21.5523 6 21 6H13ZM13 11C12.4477 11 12 11.4477 12 12C12 12.5523 12.4477 13 13 13H17C17.5523 13 18 12.5523 18 12C18 11.4477 17.5523 11 17 11H13ZM13 16C12.4477 16 12 16.4477 12 17C12 17.5523 12.4477 18 13 18H14C14.5523 18 15 17.5523 15 17C15 16.4477 14.5523 16 14 16H13Z
        </StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button#Createnew:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#BFF0B1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#121212" />
        </Style>

        <Style Selector="ToggleButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="100,0,0,0" />
            <Setter Property="Margin" Value="0,30,0,0" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ToggleButton:pointerover /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="#272727" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Background" Value="#272727" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ Path#ExpandCollapseChevron">
            <Setter Property="Stroke" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid
        ColumnDefinitions="270,*,Auto"
        RowDefinitions="110,*"
        ShowGridLines="False">


        <!-- Left bar -->
        <Border
            Grid.RowSpan="2"
            Background="#1a1a1a" />
        <Button
            x:Name="Createnew"
            Command="{Binding AddNoteOpenCommand}"
            Width="200"
            Height="50"
            HorizontalAlignment="Center"
            Background="#9dce8e"
            CornerRadius="25"
            Foreground="#121212">
            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold">
                Add Note
            </Label>
        </Button>

        <Border
            Height="1"
            VerticalAlignment="Bottom"
            Background="#2f2f2f" />

        <!-- Central part -->
        <Border
            Grid.Column="1"
            Height="1"
            Margin="20,0,20,0"
            VerticalAlignment="Bottom"
            Background="#2f2f2f" />

        <StackPanel
            Grid.Column="1"
            Margin="30,25,30,0"
            Orientation="Vertical">
            <Label
                Content="{Binding DisplayCategory}"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal">
                <Label
                    Content="{Binding NumberNotes}"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Regular" />
                <Label
                    Content="notes"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Regular" />
            </StackPanel>

        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Margin="0,0,35,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Width="48"
                Height="48"
                Margin="20"
                Background="Transparent">
                <PathIcon
                    Data="{DynamicResource Sort}"
                    Width="32"
                    Height="32"
                    Margin="0,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#dedede" />
            </Button>

            <TextBox
                Width="200"
                Height="40"
                VerticalContentAlignment="Center"
                Background="#1e1e1e"
                BorderBrush="#777777"
                CornerRadius="25"
                Watermark="Find..." />
        </StackPanel>


        <!-- Right part -->
        <DockPanel
            Grid.Column="2"
            Grid.RowSpan="2"
            Width="970"
            IsVisible="{Binding RightDockVisibility, Mode=TwoWay}">
            <Grid
                Grid.Column="2"
                Grid.RowSpan="2"
                Background="#161616"
                RowDefinitions="110,Auto,*,Auto,Auto"
                ShowGridLines="False">

                <!-- Toolbar -->
                <Grid>
                    <ComboBox
                        Width="140"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding NotesList}"
                        SelectedIndex="1"
                        SelectedItem="{Binding SelectedNote}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Category}"
                                    HorizontalAlignment="Stretch"
                                    FontSize="18"
                                    FontWeight="Medium"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">

                        <Button
                            Command="{Binding IsFavNoteChangeCommand}"
                            Width="48"
                            Height="48"
                            Margin="20,0,20,0"
                            Background="Transparent">
                            <PathIcon
                                Data="{DynamicResource Star}"
                                Width="32"
                                Height="32"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#dedede" />
                        </Button>

                        <Border
                            Width="1"
                            Height="40"
                            Background="#2F2F2F" />
                        <Button
                            Command="{Binding DeleteNoteCommand}"
                            Width="48"
                            Height="48"
                            Margin="20,0,25,0"
                            Background="Transparent">
                            <PathIcon
                                Data="{DynamicResource Delete}"
                                Width="32"
                                Height="32"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#dedede" />
                        </Button>
                    </StackPanel>


                </Grid>


                <Border
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="#2f2f2f" />

                <!-- Note area -->
                <TextBox
                    Grid.Row="1"
                    Text="{Binding SelectedNote.NoteHeader}"
                    Padding="20,30,0,30"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="20"
                    FontWeight="SemiBold" />

                <TextBox
                    Grid.Row="2"
                    Text="{Binding SelectedNote.NoteText}"
                    Padding="30,10,20,0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    FontWeight="Medium"
                    LineHeight="30"
                    TextWrapping="Wrap" />



                <!-- Information section -->
                <Grid
                    Grid.Row="3"
                    Margin="0,30,0,10"
                    RowDefinitions="Auto,Auto,Auto">
                    <Button
                        Command="{Binding InfoOpenCloseCommand}"
                        Background="Transparent">
                        <StackPanel
                            Margin="20,0,0,0"
                            Orientation="Horizontal">
                            <PathIcon
                                Data="{DynamicResource Shevron}"
                                Width="16"
                                Height="8"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                Foreground="#dedede"
                                RenderTransform="{Binding ShevronInfoRotation}" />
                            <Label
                                Padding="5,5,1000,5"
                                FontSize="20"
                                FontWeight="SemiBold">
                                Information
                            </Label>
                        </StackPanel>
                    </Button>

                    <Border
                        Grid.Row="1"
                        Height="1"
                        Background="#2F2F2F" />

                    <DockPanel
                        Grid.Row="2"
                        Margin="20"
                        IsVisible="{Binding InfoOpen}">
                        <Grid
                            HorizontalAlignment="Stretch"
                            ColumnDefinitions="*,*"
                            RowDefinitions="*,*"
                            ShowGridLines="False">
                            <CalendarDatePicker
                                Text="{Binding SelectedNote.NoteDate}"
                                Height="40"
                                Margin="0,0,15,0"
                                HorizontalAlignment="Stretch"
                                Background="#1e1e1e"
                                BorderBrush="#777777"
                                CornerRadius="15" />
                            <TextBox
                                Grid.Column="1"
                                Text="{Binding SelectedNote.NoteSource.SourceName}"
                                Height="40"
                                Margin="0,0,15,0"
                                HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Background="#1e1e1e"
                                BorderBrush="#777777"
                                CornerRadius="15"
                                Watermark="Source:" />
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- Connections section -->
                <Grid
                    Grid.Row="4"
                    Margin="0,30,0,10"
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto,Auto">
                    <Button
                        Command="{Binding ConnectionsOpenCloseCommand}"
                        Background="Transparent">
                        <StackPanel
                            Margin="20,0,0,0"
                            Orientation="Horizontal">
                            <PathIcon
                                Data="{DynamicResource Shevron}"
                                Width="16"
                                Height="8"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                Foreground="#dedede"
                                RenderTransform="{Binding ShevronConnectionsRotation}" />
                            <Label
                                Padding="5,5,1000,5"
                                FontSize="20"
                                FontWeight="SemiBold">
                                Connections
                            </Label>
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Width="35"
                        Height="35"
                        Margin="20,0,30,0"
                        Background="Transparent"
                        CornerRadius="32">
                        <Image
                            Source="..\..\Assets\Buttons\unlink.png"
                            Stretch="Uniform" />
                    </Button>

                    <Border
                        Grid.ColumnSpan="2"
                        Grid.Row="1"
                        Height="1"
                        Background="#2F2F2F" />

                    <DockPanel
                        Grid.ColumnSpan="2"
                        Grid.Row="2"
                        Margin="20"
                        IsVisible="{Binding ConnectionsOpen}" />
                </Grid>
            </Grid>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <Button
                Command="{Binding LoadAllNotesCommand}"
                Margin="20,30,20,0"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <PathIcon
                        Data="{DynamicResource Home}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                    <Label
                        Content="All Notes"
                        Margin="15,0,0,0"
                        Padding="0,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button
                Margin="20,20,20,0"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <PathIcon
                        Data="{DynamicResource Recent}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                    <Label
                        Content="Recent"
                        Margin="15,0,0,0"
                        Padding="0,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button
                Command="{Binding LoadFavNoteCommand}"
                Margin="20,20,20,0"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <PathIcon
                        Data="{DynamicResource Star}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                    <Label
                        Content="Favorites"
                        Margin="15,0,0,0"
                        Padding="0,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button
                Margin="20,20,20,30"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <PathIcon
                        Data="{DynamicResource Source}"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede" />
                    <Label
                        Content="Sources"
                        Margin="15,0,0,0"
                        Padding="0,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="#2f2f2f" />


            <!-- Left bar Categories -->
            <Grid
                Margin="0,30,0,10"
                ColumnDefinitions="*,Auto">
                <Button
                    Command="{Binding CategoriesOpenCloseCommand}"
                    Background="Transparent">
                    <StackPanel
                        Margin="20,0,0,0"
                        Orientation="Horizontal">
                        <PathIcon
                            Data="{DynamicResource Shevron}"
                            Width="16"
                            Height="8"
                            Margin="0,0,15,0"
                            VerticalAlignment="Center"
                            Foreground="#dedede"
                            RenderTransform="{Binding ShevronCategoriesRotation}" />
                        <Label
                            Padding="5,5,200,5"
                            FontSize="20"
                            FontWeight="SemiBold">
                            Categories
                        </Label>
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    Command="{Binding AddCategoryOpenCommand}"
                    Width="35"
                    Height="35"
                    Margin="20,0,5,0"
                    Background="Transparent"
                    CornerRadius="32">
                    <Image
                        Source="..\..\Assets\Buttons\plus.png"
                        Stretch="Uniform" />
                </Button>
            </Grid>

            <DockPanel
                Margin="30,0,0,0"
                IsVisible="{Binding CategoriesOpen}">
                <ListBox
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ItemsSource="{Binding CategoryList}"
                    SelectedItem="{Binding SelectedCategory}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="8"
                                    Height="8"
                                    Margin="10,0,15,0"
                                    Background="White"
                                    CornerRadius="8" />
                                <TextBlock
                                    Text="{Binding CategoryName}"
                                    Margin="0,5,0,0"
                                    FontSize="18"
                                    FontWeight="Medium" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="#666666" />
                        </Style>
                        <Style Selector="ListBoxItem:selected  /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>
        </StackPanel>

        <ListBox
            Grid.Column="1"
            Grid.Row="1"
            Background="Transparent"
            BorderBrush="Transparent"
            ItemsSource="{Binding FilteredNotes}"
            SelectedIndex="{Binding SelectedNoteIndex}"
            SelectedItem="{Binding SelectedNote}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto, *">
                        <Border
                            Width="2"
                            Height="78"
                            Margin="10,0,15,0"
                            Background="#316A42"
                            CornerRadius="8" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Vertical">
                            <TextBlock
                                Text="{Binding NoteHeader}"
                                Margin="0,5,0,0"
                                FontSize="18"
                                FontWeight="Medium"
                                TextTrimming="WordEllipsis" />
                            <TextBlock
                                Text="{Binding NoteText}"
                                Margin="5,8,0,0"
                                HorizontalAlignment="Left"
                                FontSize="18"
                                FontWeight="Regular"
                                Foreground="#B2B2B2"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Margin="5,12,0,0"
                                Orientation="Horizontal">
                                <TextBlock
                                    Text="Modified: "
                                    Margin="0,5,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Regular"
                                    Foreground="#B2B2B2" />
                                <TextBlock
                                    Text="{Binding AddedTime}"
                                    Margin="0,5,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Regular"
                                    Foreground="#B2B2B2" />
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="#666666" />
                </Style>
                <Style Selector="ListBoxItem:selected  /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>
