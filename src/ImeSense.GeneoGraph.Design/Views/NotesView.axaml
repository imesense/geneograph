<UserControl
    x:Class="ImeSense.GeneoGraph.Design.Views.NotesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:ImeSense.GeneoGraph.Design.ViewModels"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    Background="#121212"
    FontFamily="Inter"
    Foreground="#dedede"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:NotesViewModel />
    </UserControl.DataContext>

    <UserControl.Styles>
        <Style Selector="Button#Createnew:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#BFF0B1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#121212" />
        </Style>

        <Style Selector="ToggleButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="100,0,0,0" />
            <Setter Property="Margin" Value="0,30,0,0" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ToggleButton:pointerover /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="#272727" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="Background" Value="#272727" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ Path#ExpandCollapseChevron">
            <Setter Property="Stroke" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid
        ColumnDefinitions="270,*,*"
        RowDefinitions="110,*"
        ShowGridLines="False">
        <!-- Left bar -->
        <Border
            Grid.RowSpan="2"
            Background="#1a1a1a" />

        <Button
            x:Name="Createnew"
            Command="{Binding AddNoteOpenCommand}"
            Width="200"
            Height="50"
            HorizontalAlignment="Center"
            Background="#9dce8e"
            CornerRadius="25"
            Foreground="#121212">
            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold">
                Add Note
            </Label>
        </Button>

        <Border
            Height="1"
            VerticalAlignment="Bottom"
            Background="#2f2f2f" />

        <!-- Central part -->
        <StackPanel
            Grid.Column="1"
            Margin="30,25,30,0"
            Orientation="Vertical">
            <Label
                Content="{Binding SelectedCategory}"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold" />
            <Label
                Content="15 notes"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Regular" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Margin="0,0,35,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Width="48"
                Height="48"
                Margin="20"
                Background="Transparent">
                <Image
                    Source="..\Assets\Buttons\sort.png"
                    Stretch="Uniform" />
            </Button>

            <TextBox
                Width="200"
                Height="40"
                VerticalContentAlignment="Center"
                Background="#1e1e1e"
                BorderBrush="#777777"
                CornerRadius="25"
                Watermark="Find..." />
        </StackPanel>

        <!-- Central part -->
        <StackPanel
            Grid.Column="1"
            Margin="30,25,30,0"
            Orientation="Vertical">
            <Label
                Content="{Binding SelectedCategory}"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold" />
            <Label
                Content="{Binding SelectedNoteIndex}"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Regular" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Margin="0,0,35,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Width="48"
                Height="48"
                Margin="20"
                Background="Transparent">
                <Image
                    Source="..\Assets\Buttons\sort.png"
                    Stretch="Uniform" />
            </Button>

            <TextBox
                Width="200"
                Height="40"
                VerticalContentAlignment="Center"
                Background="#1e1e1e"
                BorderBrush="#777777"
                CornerRadius="25"
                Watermark="Find..." />
        </StackPanel>

        <!-- Right part -->
        <Grid
            Grid.Column="2"
            Grid.RowSpan="2"
            Background="#161616"
            RowDefinitions="110,*,Auto,Auto"
            ShowGridLines="False">

            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="#2f2f2f" />

            <TextBox
                Grid.Row="1"
                Background="Transparent"
                BorderBrush="Transparent" />

            <Expander
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="Transparent"
                IsExpanded="True">
                <Expander.Header>
                    Information
                </Expander.Header>

                <StackPanel
                    HorizontalAlignment="Stretch"
                    Orientation="Horizontal">
                    <TextBox
                        Width="300"
                        Margin="0,0,15,0"
                        Background="#1e1e1e"
                        BorderBrush="#777777"
                        CornerRadius="15"
                        Watermark="Date:" />
                    <TextBox
                        Margin="0,0,15,0"
                        HorizontalAlignment="Stretch"
                        Background="#1e1e1e"
                        BorderBrush="#777777"
                        CornerRadius="15"
                        Watermark="Source:" />
                </StackPanel>
            </Expander>

            <Expander
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="Transparent"
                IsExpanded="False">
                <Expander.Header>
                    Connections
                </Expander.Header>
            </Expander>
        </Grid>

        <!-- Right part -->
        <DockPanel
            Grid.Column="2"
            Grid.RowSpan="2"
            IsVisible="{Binding RightDockVisibility, Mode=TwoWay}">
            <Grid
                Grid.Column="2"
                Grid.RowSpan="2"
                Background="#161616"
                RowDefinitions="110,Auto,*,Auto,Auto"
                ShowGridLines="False">
                <!-- Toolbar -->
                <Grid>
                    <ComboBox
                        Width="140"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding NotesList}"
                        SelectedIndex="1"
                        SelectedItem="{Binding SelectedNote}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Category}"
                                    HorizontalAlignment="Stretch"
                                    FontSize="18"
                                    FontWeight="Medium"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding IsFavNoteChangeCommand}"
                            Width="48"
                            Height="48"
                            Margin="20,0,20,0"
                            Background="Transparent">
                            <Image
                                Source="..\Assets\Buttons\star_empty.png"
                                Stretch="Uniform" />
                        </Button>

                        <Border
                            Width="1"
                            Height="40"
                            Background="#2F2F2F" />
                        <Button
                            Command="{Binding DeleteNoteCommand}"
                            Width="48"
                            Height="48"
                            Margin="20,0,25,0"
                            Background="Transparent">
                            <Image
                                Source="..\Assets\Buttons\delete.png"
                                Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="#2f2f2f" />

                <!-- Note area -->
                <TextBox
                    Grid.Row="1"
                    Text="{Binding SelectedNote.NoteHeader}"
                    Padding="20,30,0,30"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="20"
                    FontWeight="SemiBold" />

                <TextBox
                    Grid.Row="2"
                    Text="{Binding SelectedNote.NoteText}"
                    Padding="30,10,20,0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    FontWeight="Medium"
                    LineHeight="30"
                    TextWrapping="Wrap" />

                <Expander
                    Grid.Row="3"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    IsExpanded="True">
                    <Expander.Header>
                        Information
                    </Expander.Header>
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal">
                        <TextBox
                            Width="300"
                            Margin="0,0,15,0"
                            Background="#1e1e1e"
                            BorderBrush="#777777"
                            CornerRadius="15"
                            Watermark="Date:" />
                        <TextBox
                            Margin="0,0,15,0"
                            HorizontalAlignment="Stretch"
                            Background="#1e1e1e"
                            BorderBrush="#777777"
                            CornerRadius="15"
                            Watermark="Source:" />
                    </StackPanel>
                </Expander>

                <Expander
                    Grid.Row="4"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    IsExpanded="False">
                    <Expander.Header>
                        Connections
                    </Expander.Header>
                </Expander>
            </Grid>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <Button
                Margin="20,30,20,0"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="32"
                        Height="32"
                        Source="..\Assets\Buttons\home.png"
                        Stretch="Uniform" />
                    <Label
                        Content="All Notes"
                        Margin="15,0,0,0"
                        Padding="0,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button
                Margin="20,20,20,0"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="32"
                        Height="32"
                        Source="..\Assets\Buttons\recent.png"
                        Stretch="Uniform" />
                    <Label
                        Content="Recent"
                        Margin="15,0,0,0"
                        Padding="0,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button
                Command="{Binding LoadFavNoteCommand}"
                Margin="20,20,20,0"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="32"
                        Height="32"
                        Source="..\Assets\Buttons\star.png"
                        Stretch="Uniform" />
                    <Label
                        Content="Favorites"
                        Margin="15,0,0,0"
                        Padding="0,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button
                Margin="20,20,20,30"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="32"
                        Height="32"
                        Source="..\Assets\Buttons\source.png"
                        Stretch="Uniform" />
                    <Label
                        Content="Sources"
                        Margin="15,0,0,0"
                        Padding="0,5,0,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="#2f2f2f" />

            <Expander
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="Transparent"
                IsExpanded="True">
                <Expander.Header>
                    Categories
                </Expander.Header>

                <ListBox
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ItemsSource="{Binding CategoryList}"
                    SelectedItem="{Binding SelectedCategory}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="8"
                                    Height="8"
                                    Margin="10,0,15,0"
                                    Background="White"
                                    CornerRadius="8" />
                                <TextBlock
                                    Text="{Binding CategoryName}"
                                    Margin="0,5,0,0"
                                    FontSize="18"
                                    FontWeight="Medium" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="#666666" />
                        </Style>
                        <Style Selector="ListBoxItem:selected  /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Expander>
        </StackPanel>

        <ListBox
            Grid.Column="1"
            Grid.Row="1"
            Background="Transparent"
            BorderBrush="Transparent"
            ItemsSource="{Binding FilteredNotes}"
            SelectedIndex="{Binding SelectedNoteIndex}"
            SelectedItem="{Binding SelectedNote}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto, *">
                        <Border
                            Width="2"
                            Height="78"
                            Margin="10,0,15,0"
                            Background="#316A42"
                            CornerRadius="8" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Vertical">
                            <TextBlock
                                Text="{Binding NoteHeader}"
                                Margin="0,5,0,0"
                                FontSize="18"
                                FontWeight="Medium"
                                TextTrimming="WordEllipsis" />
                            <TextBlock
                                Text="{Binding NoteText}"
                                Margin="5,8,0,0"
                                HorizontalAlignment="Left"
                                FontSize="18"
                                FontWeight="Regular"
                                Foreground="#B2B2B2"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Margin="5,12,0,0"
                                Orientation="Horizontal">
                                <TextBlock
                                    Text="Modified: "
                                    Margin="0,5,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Regular"
                                    Foreground="#B2B2B2" />
                                <TextBlock
                                    Text="{Binding AddedTime}"
                                    Margin="0,5,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Regular"
                                    Foreground="#B2B2B2" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="#666666" />
                </Style>
                <Style Selector="ListBoxItem:selected  /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>
