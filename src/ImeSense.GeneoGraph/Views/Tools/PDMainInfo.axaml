<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="588"
             x:Class="ImeSense.GeneoGraph.Views.Tools.PDMainInfo"
             FontFamily="Inter"
             FontSize="16"
             FontWeight="Medium"
             Background="Transparent">
    <Grid Background="Transparent"
          ShowGridLines="False"
          ColumnDefinitions="*,*,*"
          RowDefinitions="Auto, Auto, Auto, Auto, Auto"
          Margin="25">

        
    <!--///Column 1///-->
        <!--First name-->
        <StackPanel 
            Margin="0,0,10,0">
            <Label 
                Content="First Name"
                Margin="0,0,0,5"/>
            <TextBox
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""/>
        </StackPanel>

        <!--Patronym name-->
        <StackPanel
                Margin="0,20,10,0"
                Grid.Row="1">
            <Label
                Content="Patronym"
                Margin="0,0,0,5"/>
            <TextBox
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""/>
        </StackPanel>

        <!--Birth date group-->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ShowGridLines="False"
              Margin="0,35,0,0">
            <StackPanel
                Margin="0,0,15,0">
                <Label
                    Content="Birth Date"
                    Margin="0,0,0,5"/>
                <ComboBox
                    Grid.Row="1"
                    Background="#121212"
                    Height="40"
                    BorderThickness="0,0,0,2"
                    BorderBrush="#316A42"
                    CornerRadius="5"
                    HorizontalAlignment="Stretch"
                    />
            </StackPanel>
            <TextBox
                Grid.Column="1"
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""
                VerticalAlignment="Bottom"
                Margin="0,0,10,0"/>

            <TextBox
                Grid.Column="1"
                Grid.Row="1"
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                Margin="0,20,10,0"
                CornerRadius="5"
                Text=""/>
        </Grid>

        <!--Death date group-->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ShowGridLines="False"
              Margin="0,35,0,0"
              Grid.RowSpan="2">
            <StackPanel
                Margin="0,0,15,0">
                <Label
                    Content="Death Date"
                    Margin="0,0,0,5"/>
                <ComboBox
                    Grid.Row="1"
                    Background="#121212"
                    Height="40"
                    BorderThickness="0,0,0,2"
                    BorderBrush="#316A42"
                    CornerRadius="5"
                    HorizontalAlignment="Stretch"
                    />
            </StackPanel>
            <TextBox
                Grid.Column="1"
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""
                VerticalAlignment="Bottom"
                Margin="0,0,10,0"/>

            <TextBox
                Grid.Column="1"
                Grid.Row="1"
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                Margin="0,20,10,0"
                CornerRadius="5"
                Text=""/>
        </Grid>

    <!--///Column 2///-->
        <!--Last name-->
        <StackPanel
            Margin="10,0,0,0"
            Grid.Column="1">
            <Label
                Content="Last Name"
                Margin="0,0,0,5"/>
            <TextBox
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""/>
        </StackPanel>

        <!--Maiden name-->
        <StackPanel
            Margin="10,20,0,0"
            Grid.Column="1"
            Grid.Row="1">
            <Label
                Content="Maiden Name"
                Margin="0,0,0,5"/>
            <TextBox
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""/>
        </StackPanel>

        <!--Birth place-->
        <StackPanel
            Margin="10,35,0,0"
            Grid.Column="1"
            Grid.Row="2">
            <Label
                Content="Birth Place"
                Margin="0,0,0,5"/>
            <TextBox
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""/>
        </StackPanel>

        <!--Death place-->
        <StackPanel
            Margin="10,35,0,0"
            Grid.Column="1"
            Grid.Row="3">
            <Label
                Content="Death Place"
                Margin="0,0,0,5"/>
            <TextBox
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""/>
        </StackPanel>

        <!--///Column 3///-->
        <!--Gender-->
        <StackPanel
            Margin="40,0,0,0"
            Grid.Column="2">
            <Label
                Content="Gender"
                Margin="0,0,0,5"/>
            <ComboBox
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!--Prefix and Suffix-->
        <Grid Grid.Column="2"
              Grid.Row="1"
              ColumnDefinitions="*,*"
              Margin="40,0,0,0">
            <StackPanel VerticalAlignment="Bottom">
                <Label
                    Content="Prefix"
                    Margin="0,0,0,5"/>
                <TextBox
                    Background="#121212"
                    Height="40"
                    BorderThickness="0,0,0,2"
                    BorderBrush="#316A42"
                    CornerRadius="5"
                    Text=""
                    Margin="0,0,10,0"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom"
                        Grid.Column="1"
                        Margin="10,0,0,0">
                <Label
                    Content="Suffix"
                    Margin="0,0,0,5"/>
                <TextBox
                    Background="#121212"
                    Height="40"
                    BorderThickness="0,0,0,2"
                    BorderBrush="#316A42"
                    CornerRadius="5"
                    Text=""/>
            </StackPanel>
        </Grid>

        <!--Living and Deceased radio buttons-->


        <!--Cause of death-->
        <StackPanel
            Margin="40,35,0,0"
            Grid.Column="2"
            Grid.Row="3">
            <Label
                Content="Cause of Death"
                Margin="0,0,0,5"/>
            <TextBox
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""/>
        </StackPanel>
        <!--Burial place-->

        <StackPanel
            Margin="40,20,0,0"
            Grid.Column="2"
            Grid.Row="4">
            <Label
                Content="Burial Place"
                Margin="0,0,0,5"/>
            <TextBox
                Background="#121212"
                Height="40"
                BorderThickness="0,0,0,2"
                BorderBrush="#316A42"
                CornerRadius="5"
                Text=""/>
        </StackPanel>
    </Grid>
</UserControl>
