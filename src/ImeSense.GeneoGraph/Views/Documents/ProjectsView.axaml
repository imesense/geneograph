<UserControl
    x:Class="ImeSense.GeneoGraph.Views.Documents.ProjectsView"
    x:DataType="vmd:ProjectsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vmd="using:ImeSense.GeneoGraph.ViewModels.Documents"
    d:DesignHeight="450"
    d:DesignWidth="600"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource Background.Brushes.Main}" />
</UserControl>
