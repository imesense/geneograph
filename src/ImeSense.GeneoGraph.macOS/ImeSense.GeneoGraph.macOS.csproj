<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net7.0-macos;net8.0-macos</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

        <OutputPath>$(BaseOutputPath)\$(Configuration)\$(TargetFramework)</OutputPath>
        <UseAppHost>true</UseAppHost>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <ApplicationId>org.imesense.GeneoGraph</ApplicationId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net7.0-macos'">
        <SupportedOSPlatformVersion >13.0</SupportedOSPlatformVersion>
        <RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-macos'">
        <SupportedOSPlatformVersion >14.2</SupportedOSPlatformVersion>
        <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ImeSense.GeneoGraph\ImeSense.GeneoGraph.csproj" />
    </ItemGroup>
</Project>
