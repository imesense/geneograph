<UserControl
    x:Class="ImeSense.GeneoGraph.Layout.Views.PDConnections"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignHeight="638"
    d:DesignWidth="500"
    FontFamily="Inter"
    FontSize="16"
    FontWeight="Medium"
    mc:Ignorable="d">

    <UserControl.Resources>
        <StreamGeometry x:Key="Arrow">
            M13.2599 16.2802C13.0699 16.2802 12.8799 16.2102 12.7299 16.0602L9.19992 12.5302C8.90992 12.2402 8.90992 11.7602 9.19992 11.4702L12.7299 7.94016C13.0199 7.65016 13.4999 7.65016 13.7899 7.94016C14.0799 8.23016 14.0799 8.71016 13.7899 9.00016L10.7899 12.0002L13.7899 15.0002C14.0799 15.2902 14.0799 15.7702 13.7899 16.0602C13.6499 16.2102 13.4599 16.2802 13.2599 16.2802Z
        </StreamGeometry>
        <StreamGeometry x:Key="Plus">
            M960 448H576V64a64 64 0 0 0-128 0v384H64a64 64 0 0 0 0 128h384v384a64 64 0 0 0 128 0V576h384a64 64 0 0 0 0-128z
        </StreamGeometry>
    </UserControl.Resources>

    <Grid
        Margin="20"
        ColumnDefinitions="*,*"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

        <!-- Photos group -->
        <Label
            FontFamily="Roboto"
            FontSize="18">
            PHOTOS
        </Label>
        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="35"
                Height="35"
                Margin="0,0,10,0"
                Background="Transparent"
                CornerRadius="32">
                <PathIcon
                    Data="{DynamicResource Plus}"
                    Width="16"
                    Height="16"
                    Margin="0,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#dedede" />
            </Button>

            <Button
                Width="35"
                Height="35"
                Background="Transparent"
                CornerRadius="32">
                <Border
                    Width="26"
                    Height="26"
                    BorderBrush="#dedede"
                    BorderThickness="2"
                    CornerRadius="32">
                    <PathIcon
                        Data="{DynamicResource Arrow}"
                        Width="14"
                        Height="14"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede"
                        RenderTransform="rotate(180deg)" />
                </Border>
            </Button>
        </StackPanel>
        <Border
            Grid.ColumnSpan="2"
            Grid.Row="1"
            Height="135"
            Background="Gainsboro">
            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Green">
                Placeholder
            </Label>
        </Border>

        <!-- Files group -->
        <Label
            Grid.Row="2"
            Margin="0,30,0,0"
            FontFamily="Roboto"
            FontSize="18">
            FILES
        </Label>
        <StackPanel
            Grid.Column="1"
            Grid.Row="2"
            Margin="0,30,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="35"
                Height="35"
                Margin="0,0,10,0"
                Background="Transparent"
                CornerRadius="32">
                <PathIcon
                    Data="{DynamicResource Plus}"
                    Width="16"
                    Height="16"
                    Margin="0,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#dedede" />
            </Button>

            <Button
                Width="35"
                Height="35"
                Background="Transparent"
                CornerRadius="32">
                <Border
                    Width="26"
                    Height="26"
                    BorderBrush="#dedede"
                    BorderThickness="2"
                    CornerRadius="32">
                    <PathIcon
                        Data="{DynamicResource Arrow}"
                        Width="14"
                        Height="14"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede"
                        RenderTransform="rotate(180deg)" />
                </Border>
            </Button>
        </StackPanel>
        <Border
            Grid.ColumnSpan="2"
            Grid.Row="3"
            Height="135"
            Background="Gainsboro">
            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Green">
                Placeholder
            </Label>
        </Border>

        <!-- Notes group -->
        <Label
            Grid.Row="4"
            Margin="0,30,0,0"
            FontFamily="Roboto"
            FontSize="18">
            NOTES
        </Label>
        <StackPanel
            Grid.Column="1"
            Grid.Row="4"
            Margin="0,30,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="35"
                Height="35"
                Margin="0,0,10,0"
                Background="Transparent"
                CornerRadius="32">
                <PathIcon
                    Data="{DynamicResource Plus}"
                    Width="16"
                    Height="16"
                    Margin="0,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#dedede" />
            </Button>

            <Button
                Width="35"
                Height="35"
                Background="Transparent"
                CornerRadius="32">
                <Border
                    Width="26"
                    Height="26"
                    BorderBrush="#dedede"
                    BorderThickness="2"
                    CornerRadius="32">
                    <PathIcon
                        Data="{DynamicResource Arrow}"
                        Width="14"
                        Height="14"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#dedede"
                        RenderTransform="rotate(180deg)" />
                </Border>
            </Button>
        </StackPanel>
        <Border
            Grid.ColumnSpan="2"
            Grid.Row="5"
            Height="135"
            Background="Gainsboro">
            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Green">
                Placeholder
            </Label>
        </Border>


    </Grid>
</UserControl>
