<UserControl
    x:Class="ImeSense.GeneoGraph.Layout.Views.PDOther"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    MinHeight="588"
    d:DesignHeight="588"
    d:DesignWidth="850"
    Background="Transparent"
    FontFamily="Inter"
    FontSize="16"
    FontWeight="Medium"
    mc:Ignorable="d">
    <Grid
        Margin="25"
        ColumnDefinitions="*,*,*"
        RowDefinitions="Auto,Auto,Auto">
        <!-- Religion -->
        <StackPanel>
            <Label
                Content="Religion"
                Margin="0,0,0,5" />
            <ComboBox
                Height="40"
                HorizontalAlignment="Stretch"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </StackPanel>

        <!-- Baptism place -->
        <StackPanel
            Grid.Row="1"
            Margin="0,20,0,0">
            <Label
                Content="Baptism Place"
                Margin="0,0,0,5" />
            <TextBox
                Text=""
                Height="40"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </StackPanel>

        <!-- Baptism date group -->
        <Grid
            Grid.Row="2"
            Margin="0,35,0,0"
            ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto"
            ShowGridLines="False">
            <StackPanel Margin="0,0,15,0">
                <Label
                    Content="Baptism Date"
                    Margin="0,0,0,5" />
                <ComboBox
                    Grid.Row="1"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Background="#121212"
                    BorderBrush="#316A42"
                    BorderThickness="0,0,0,2"
                    CornerRadius="5" />
            </StackPanel>

            <TextBox
                Grid.Column="1"
                Text=""
                Height="40"
                Margin="0,0,10,0"
                VerticalAlignment="Bottom"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />

            <TextBox
                Grid.Column="1"
                Grid.Row="1"
                Text=""
                Height="40"
                Margin="0,20,10,0"
                Background="#121212"
                BorderBrush="#316A42"
                BorderThickness="0,0,0,2"
                CornerRadius="5" />
        </Grid>
    </Grid>
</UserControl>
